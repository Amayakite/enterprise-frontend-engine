# 业务表单新选址使用的一家地图；已有位置按原厂商回显
VITE_MAP_PROVIDER=amap

# 将需要的两行复制到 .env.development.local，填好后重启 pnpm dev。
# 仅浏览器端凭证，真实值不要提交。数组从前向后尝试，同账号多 Key 不增加账号配额。
VITE_AMAP_KEYS='[{"key":"your-amap-web-js-key","securityJsCode":"your-security-code"}]'
VITE_TENCENT_KEYS='[{"key":"your-tencent-web-js-key"}]'
# 高德生产环境建议改用安全代理：
# VITE_AMAP_KEYS='[{"key":"your-amap-web-js-key","serviceHost":"https://example.com/_AMapService"}]'

# OSM：开发页默认使用本地开发代理，浏览器不直连海外公共服务。
# 以下 OSM_OVERPASS_URL 仅供 Vite 开发服务读取，不进入浏览器；可改为自建实例。
# OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# 生产环境须由部署方提供同源边界服务，返回 WGS84 GeoJSON FeatureCollection。
# 未配置生产路径时不启用 OSM 查询；开发代理不包含在 dist 中。
# VITE_OSM_BOUNDARY_URL=/api/maps/osm-boundaries
