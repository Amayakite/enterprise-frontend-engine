{
  "name": "enterprise-frontend-engine",
  "description": "面向企业业务系统的通用前端开发引擎，提供配置驱动的 CRUD、业务字段、参照导航与统一操作反馈。",
  "version": "4.7.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "node scripts/run-tests.mjs all",
    "test:quick": "node scripts/run-tests.mjs quick",
    "test:contracts": "node scripts/run-tests.mjs contracts",
    "bench:crud": "node --expose-gc tests/performance/crud.bench.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.3.0",
    "@wangeditor-next/editor": "^5.7.13",
    "@wangeditor-next/editor-for-vue": "^5.1.14",
    "animate.css": "^4.1.1",
    "async-validator": "4.2.5",
    "axios": "^1.18.1",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.2",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "^8.4.2",
    "pinia": "^3.0.4",
    "qs": "^6.15.2",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.38",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.1.0",
    "vxe-table": "~4.6.25"
  },
  "devDependencies": {
    "@iconify/utils": "^3.1.3",
    "@types/node": "^26.0.0",
    "@types/nprogress": "^0.2.3",
    "@types/path-browserify": "^1.0.3",
    "@types/qs": "^6.15.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.4",
    "sass": "^1.101.0",
    "typescript": "^5.9.3",
    "unocss": "^66.7.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.0.6",
    "vite-plugin-mock-dev-server": "^2.4.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.16.0"
}
