{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "element-plus/global"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "mock/**/*.ts", "vite.config.ts", "uno.config.ts"],
  "exclude": ["node_modules", "dist"]
}
